<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="code coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Exclude>
								<ModulePath>.*Enrollment\.ChatHub\.Flow\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>